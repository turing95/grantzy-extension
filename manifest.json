{
  "manifest_version": 3,
  "name": "Grantzy fill form",
  "version": "1.0",
  "description": "Fill forms with Grantzy data",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://grantzy.com/"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "css": [
        "styles/content.css"
      ],
      "js": [
        "dist/bundle.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/logo.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}