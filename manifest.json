{
  "manifest_version": 3,
  "name": "Grantzy fill form",
  "version": "1.0",
  "description": "Fill forms with Grantzy data",
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://grantzy.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grantzy.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/webappBridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
