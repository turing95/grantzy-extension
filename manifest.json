{
  "manifest_version": 3,
  "name": "Grantzy form assistant",
  "version": "2.2.0",
  "description": "Assistente che ti aiuta a completare form web",
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grantzy.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/webappBridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
